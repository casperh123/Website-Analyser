  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "tokenType": {
            "type": [
              "null",
              "string"
            ]
          },
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "BrokenLink": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "brokenLinkCrawlId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "brokenLinkCrawl": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BrokenLinkCrawl"
              }
            ]
          },
          "targetPage": {
            "type": "string"
          },
          "referringPage": {
            "type": "string"
          },
          "anchorText": {
            "type": "string"
          },
          "line": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "statusCode": {
            "$ref": "#/components/schemas/HttpStatusCode"
          }
        }
      },
      "BrokenLinkCrawl": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "brokenLinks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BrokenLink"
            }
          },
          "linksChecked": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BrokenLinkCrawlDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "localTime": {
            "type": "string",
            "format": "date-time"
          },
          "linksChecked": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "brokenLinks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BrokenLinkDTO"
            }
          }
        }
      },
      "BrokenLinkDTO": {
        "required": [
          "targetPage",
          "referringPage",
          "anchorText",
          "line",
          "statusCode"
        ],
        "type": "object",
        "properties": {
          "targetPage": {
            "type": "string"
          },
          "referringPage": {
            "type": "string"
          },
          "anchorText": {
            "type": "string"
          },
          "line": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "statusCode": {
            "$ref": "#/components/schemas/HttpStatusCode"
          }
        }
      },
      "CacheWarmDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "websiteId": {
            "type": "string",
            "format": "uuid"
          },
          "visitedPages": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "startTimeUtc": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "averagePageTime": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isCompleted": {
            "type": "boolean"
          },
          "totalTime": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "startTimeLocal": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateEmailSubscription": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "websiteId": {
            "type": "string",
            "format": "uuid"
          },
          "scheduledActionId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "CreateWebsiteRequest": {
        "required": [
