@using WebsiteAnalyzer.Core.Domain
@using WebsiteAnalyzer.Core.Interfaces.Services.DTOs.Website
@inject NavigationManager NavigationManager

<RadzenRow>
    <RadzenLink Path="/" >
        <RadzenButton Icon="keyboard_arrow_left" Size="ButtonSize.Medium" Style="margin-bottom: 40px;"/>
    </RadzenLink>
    <RadzenDropDown Data="Websites" Value="Website" TValue="WebsiteDTO" TextProperty="@nameof(Website.Name)" ValueChanged="@((website) => NavigateToWebsite(website))"/>
</RadzenRow>

@if (Website is not null)
{
    <RadzenStack Style="margin-bottom: 40px;" Gap="0">
        <RadzenText TextStyle="TextStyle.DisplayH1" Style="margin-bottom: 0;">@Website?.Name</RadzenText>
        <RadzenLink Path="@Website.Url">@Website.Url</RadzenLink>
    </RadzenStack>  
    
    <RadzenRow>
        <RadzenStack>
            <WebsiteStatsMenu Website="Website"/>
        </RadzenStack>

        <RadzenColumn>
            <RadzenStack>
                @ChildContent
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
}
else
{
    <RadzenText TextStyle="TextStyle.DisplayH1">Could not find website</RadzenText>
    <RadzenLink Path="/"><RadzenButton>Go back to websites</RadzenButton></RadzenLink>
}

@code {
    [Parameter, EditorRequired]
    public required WebsiteDTO? Website { get; set; }

    [Parameter, EditorRequired]
    public required IEnumerable<WebsiteDTO> Websites { get; set; }
    
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    public void NavigateToWebsite(WebsiteDTO? website)
    {
        string newUrl = NavigationManager.Uri.Replace($"/{Website?.Id}", $"/{website?.Id}");
        NavigationManager.NavigateTo(newUrl, forceLoad: true);
    }
}